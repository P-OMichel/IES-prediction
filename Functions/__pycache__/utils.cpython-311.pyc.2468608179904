    def initialize_slider(self):

        self.left_slider.setMinimum(0)
        self.left_slider.setMaximum(self.N_y-512)
        self.right_slider.setMinimum(512) # 4 s
        self.right_slider.setMaximum(128*10*6*10) # 10 min 

        self.left_slider.setValue(0)
        self.right_slider.setValue(1280*3) # 30 s

        self.left_slider.valueChanged.connect(self.update)
        self.right_slider.valueChanged.connect(self.update)

    def initialize_get_record(self):

        for i in range(4,12):
            self.D_get_record[str(i)](self.y,self.t,self.fs)

    def plot_spectrogram(self):

        self.axis0.cla()

        # compute spectrogram
        delta_f=0.5
        delta_t=2
        nfft=int(self.fs/delta_f)
        overlap=int(nfft-delta_t*self.fs)
        overlap=nfft-32
        f_spectro,t_spectro,spectro=sc.signal.spectrogram(self.y,self.fs,nperseg=nfft,noverlap=overlap)
        delta_f=f_spectro[1]-f_spectro[0]

        self.axis0.pcolormesh(t_spectro,f_spectro[int(1/delta_f):int(50/delta_f)],np.log(spectro[int(1/delta_f):int(50/delta_f),:]+0.000001),shading='nearest',cmap='rainbow',vmin=np.log(1.e-2),vmax=np.log(10))#,vmin=1.e-10,vmax=10)
        self.canvas0.draw()

